<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: 조회(CAR_*) 퍼미션만 쓴다. 제어(CONTROL_CAR_*)는 쓰지 않는다. -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NanwotaApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_mark"
        android:theme="@style/Theme.Nanwota"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
